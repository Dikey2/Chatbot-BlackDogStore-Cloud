# Copiar a .env y completar. El archivo .env NO se sube al repositorio.
# Generar cada secreto con:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"

# --- Django (API principal) ---
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
# true en producción (Render, HTTPS): cookies seguras, HSTS y redirección a HTTPS.
DJANGO_HTTPS=false

# --- Servicio de chatbot ---
CHATBOT_SECRET_KEY=

# --- PostgreSQL (base académica, solo datos ficticios) ---
POSTGRES_DB=blackdog_chatbot
POSTGRES_USER=blackdog
POSTGRES_PASSWORD=
# Solo fuera de Docker Compose (por ejemplo, Neon desde Render). En local: db y 5432.
POSTGRES_HOST=
POSTGRES_PORT=
# Neon exige SSL: require. Vacío en local.
POSTGRES_SSLMODE=
# Segundos que se reutiliza una conexión (0 = una conexión por petición).
POSTGRES_CONN_MAX_AGE=60

# --- Datos de demostración (python manage.py seed_demo) ---
# Contraseña de admin@example.com, asesor@example.com y cliente@example.com.
DEMO_PASSWORD=

# --- Rate limits de la API (peticiones por periodo: s, min, hour, day) ---
THROTTLE_ANON=60/min
THROTTLE_USER=120/min
THROTTLE_AUTH=10/min
THROTTLE_CHAT=30/min

# --- Procesos de gunicorn del backend ---
GUNICORN_WORKERS=4
# Hilos por proceso (atienden otra petición mientras se espera al chatbot o a la base).
GUNICORN_THREADS=1
# Procesos del servicio de chatbot.
CHATBOT_WORKERS=2

# --- CORS: orígenes que pueden llamar a la API desde un navegador (sin comodines) ---
# Desarrollo: http://localhost:3000,http://127.0.0.1:3000. Producción: URL HTTPS del frontend.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Proxies de confianza delante de la API (Render = 1; vacío en local) ---
NUM_PROXIES=

# --- Plataforma multiempresa y widget público ---
# Negocio de los clientes registrados del chat de la plataforma (el piloto).
DEFAULT_BUSINESS_SLUG=black-dog-store
# URL pública de la API: la que aparece en el código de instalación del widget.
API_PUBLIC_URL=http://localhost:8000
# Orígenes del propio panel que pueden cargar cualquier widget (vista previa).
WIDGET_PREVIEW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Sesión anónima del visitante (horas) y mensajes máximos por sesión.
WIDGET_SESSION_TTL_HOURS=24
WIDGET_MAX_MESSAGES_PER_SESSION=200
# Rate limits del widget: sesiones y lecturas por IP; mensajes por visitante y por IP.
THROTTLE_WIDGET_SESSION=10/min
THROTTLE_WIDGET_READ=120/min
THROTTLE_WIDGET_MESSAGE=20/min
THROTTLE_WIDGET_MESSAGE_IP=60/min

# --- Logs estructurados (JSON) ---
LOG_LEVEL=INFO
# Peticiones más lentas que esto (ms) se registran como slow_request.
SLOW_REQUEST_MS=1000

# --- Datos de demostración del widget (seed_demo) ---
# Orígenes autorizados de las dos webs de demostración y sus ids públicos fijos.
SEED_PILOT_ORIGINS=http://localhost:3002,http://127.0.0.1:3002
SEED_SECOND_ORIGINS=http://localhost:8090,http://127.0.0.1:8090
SEED_PILOT_PUBLIC_ID=bd_demo_blackdog
SEED_SECOND_PUBLIC_ID=bd_demo_cafe

# --- Varios stacks en el mismo equipo (opcional) ---
# COMPOSE_PROJECT_NAME=blackdog-saas
# BACKEND_PORT=8010
# CHATBOT_PORT=8011
# FRONTEND_PORT=3010
# DEMO_CAFE_PORT=8090

# --- Sesión: horas de validez del token de la API ---
TOKEN_TTL_HOURS=8

# --- Frontend ---
# true solo cuando el sitio se sirve por HTTPS.
COOKIE_SECURE=false

# --- AWS (aún sin uso; no se han creado recursos). Ver infra/aws/README.md ---
AWS_REGION=
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Solo con credenciales temporales (AWS Academy Learner Lab).
AWS_SESSION_TOKEN=
