
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

# Dependencias con versiones y hashes verificados.
COPY requirements.render.lock /tmp/requirements.render.lock

RUN python -m pip install \
    --no-cache-dir \
    --only-binary=:all: \
    --require-hashes \
    -r /tmp/requirements.render.lock

# Aplicaciones independientes.
COPY backend/ /app/backend/
COPY services/chatbot/ /app/services/chatbot/

# Script de inicio de ambos servicios.
COPY infra/render/start.py /app/start.py

# Usuario sin privilegios de administrador.
RUN useradd --create-home app \
    && chown -R app:app /app

USER app

EXPOSE 8000

CMD ["python", "/app/start.py"]
