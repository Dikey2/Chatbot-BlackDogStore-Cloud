
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

# Dependencias de ambos servicios.
COPY backend/requirements.txt /tmp/backend-requirements.txt
COPY services/chatbot/requirements.txt /tmp/chatbot-requirements.txt

RUN pip install --no-cache-dir \
    -r /tmp/backend-requirements.txt \
    -r /tmp/chatbot-requirements.txt

# Aplicaciones independientes.
COPY backend/ /app/backend/
COPY services/chatbot/ /app/services/chatbot/

# Script que iniciará los dos servicios.
COPY infra/render/start.py /app/start.py

# Usuario sin privilegios de administrador.
RUN useradd --create-home app \
    && chown -R app:app /app

USER app

EXPOSE 8000

CMD ["python", "/app/start.py"]
